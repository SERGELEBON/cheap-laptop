// Cheap Laptops Ghana — Prisma schema (PostgreSQL / Supabase)
// Money is stored as integer pesewas (1 GH₵ = 100) to avoid float errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* Staff & access control                                              */
/* ------------------------------------------------------------------ */

/// Roles, highest privilege first. Permissions live in src/lib/rbac.ts.
enum Role {
  OWNER // full control, incl. other owners
  ADMIN // full control except owners
  MANAGER // catalogue, stock, orders, finance reports
  INVENTORY // stock keeper: products (read) + stock movements
  SALES // order desk: orders + product/stock lookup
  VIEWER // read-only (accountant, analyst)
}

model StaffUser {
  id             Int       @id @default(autoincrement())
  email          String    @unique // lowercase Google account email
  name           String?
  image          String?
  googleSub      String?   @unique // bound on first Google sign-in
  role           Role      @default(VIEWER)
  active         Boolean   @default(true)
  sessionVersion Int       @default(1) // bump to revoke every session
  lastLoginAt    DateTime?
  invitedById    Int?
  invitedBy      StaffUser?  @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invited        StaffUser[] @relation("Invites")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stockMovements StockMovement[]
  auditLogs      AuditLog[]
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  actorId   Int?
  actor     StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // kept even if the staff user is deleted
  action    String // e.g. product.update, stock.adjust, staff.role
  entity    String? // Product | Order | StaffUser
  entityId  String?
  summary   String  @default("")
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/* ------------------------------------------------------------------ */
/* Catalogue & inventory                                               */
/* ------------------------------------------------------------------ */

enum ProductStatus {
  ACTIVE // visible in the store
  DRAFT // being prepared, hidden
  ARCHIVED // retired, hidden, kept for order history
}

model Product {
  id                Int           @id @default(autoincrement())
  slug              String        @unique
  name              String
  sku               String        @unique
  status            ProductStatus @default(ACTIVE)
  price             Int // pesewas
  regularPrice      Int? // pesewas
  costPrice         Int? // pesewas — purchase cost, finance roles only
  onSale            Boolean       @default(false)
  discount          Int           @default(0)
  image             String?
  categorySlugs     String        @default("") // comma-separated category slugs
  brandSlug         String?
  shortDescription  String        @default("")
  description       String        @default("")
  averageRating     Float         @default(0)
  reviewCount       Int           @default(0)
  stock             Int           @default(10)
  lowStockThreshold Int           @default(3)
  featured          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  movements StockMovement[]

  @@index([status])
}

enum StockMovementType {
  INITIAL // opening stock when the product is created
  RESTOCK // goods received from supplier (+)
  RETURN // customer return back to shelf (+)
  SALE // order placed (-)
  CANCEL // order cancelled, stock restored (+)
  DAMAGE // damaged / defective (-)
  LOSS // lost / stolen (-)
  COUNT // physical count correction (set absolute)
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  productId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int // signed change applied to stock
  stockBefore Int
  stockAfter  Int
  note        String?
  orderId     Int?
  actorId     Int?
  actor       StaffUser?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
}

/* ------------------------------------------------------------------ */
/* Orders                                                              */
/* ------------------------------------------------------------------ */

model Order {
  id           Int         @id @default(autoincrement())
  ref          String      @unique
  customerName String
  phone        String
  email        String?
  address      String
  city         String
  region       String
  notes        String?
  payment      String
  subtotal     Int // pesewas
  shipping     Int // pesewas
  total        Int // pesewas
  status       String      @default("pending") // pending | processing | shipped | delivered | cancelled
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int?
  name      String
  price     Int // pesewas (unit price captured at purchase time)
  qty       Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId])
}
