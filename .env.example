# ── Database (Neon via Vercel → Storage; Vercel injects both automatically)
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"      # pooled, used at runtime
DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"       # direct, used by prisma db push

# ── Staff sign-in with Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
#    Authorized redirect URI:  https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public URL of the site (used to build the OAuth redirect URI). No trailing slash.
APP_URL="https://cheaplaptop.vercel.app"

# 32+ random characters, used to sign session cookies:  openssl rand -base64 48
AUTH_SECRET=""

# Comma-separated Google emails that become OWNER on their first sign-in (bootstrap).
OWNER_EMAILS="you@example.com"
